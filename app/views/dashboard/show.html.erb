<% content_for :title, "Dashboard · tinyslug" %>

<section class="mx-auto max-w-6xl px-5 py-12">
  <div>
    <p class="eyebrow">Dashboard</p>
    <h1 class="mt-2 font-mono text-3xl font-semibold tracking-tight">Welcome, <%= current_user.profile.display_name %>.</h1>
    <p class="mt-3 text-ink-muted">Recent links and visit activity for your account.</p>
  </div>

  <div class="mt-10 grid gap-5 sm:grid-cols-2">
    <div class="card p-6">
      <p class="eyebrow">Total links</p>
      <p id="links-count" class="mt-3 font-mono text-3xl font-semibold text-ink"><%= number_with_delimiter(@links_count) %></p>
    </div>
    <div class="card p-6">
      <p class="eyebrow">Visits, last 7 days</p>
      <p id="weekly-visits" class="mt-3 font-mono text-3xl font-semibold text-ink"><%= number_with_delimiter(@weekly_visits) %></p>
      <p class="mt-2 text-sm text-ink-muted">Counted across your links with tracking enabled.</p>
    </div>
  </div>

  <% if @links_count.zero? %>
    <div class="mt-10 rounded-[10px] border border-dashed border-line px-6 py-16 text-center">
      <p class="eyebrow">No links yet</p>
      <p class="mx-auto mt-3 max-w-md text-ink-muted">Create your first short link to start organizing destinations and measuring visits.</p>
      <%= link_to "Manage links", links_path, class: "btn btn-primary mt-6" %>
    </div>
  <% else %>
    <div class="mt-12 flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-mono text-lg font-semibold">Recent links</h2>
      <%= link_to "Manage links", links_path, class: "btn btn-secondary" %>
    </div>
    <div id="recent-links" class="mt-4 space-y-3">
      <% @recent_links.each do |link| %>
        <article class="card p-5">
          <%= link_to link.short_url, link.short_url, target: "_blank", rel: "noopener", class: "slug-chip text-base break-all" %>
          <p class="mt-2 truncate font-mono text-sm text-ink-muted"><%= link.destination_url %></p>
          <% if link.name.present? && link.name != link.destination_url %>
            <h3 class="mt-3 max-w-full truncate text-sm font-medium text-ink"><%= link.name %></h3>
          <% end %>
        </article>
      <% end %>
    </div>
  <% end %>
</section>
