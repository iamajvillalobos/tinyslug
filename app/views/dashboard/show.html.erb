<% content_for :title, "Dashboard · tinyslug" %>

<section class="mx-auto max-w-6xl px-5 py-12">
  <div>
    <p class="text-sm font-medium text-lime-300">Dashboard</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Welcome, <%= current_user.profile.display_name %>.</h1>
    <p class="mt-3 text-slate-400">Your links and privacy-safe signals will live here.</p>
  </div>

  <div class="mt-10 rounded-3xl border border-dashed border-white/15 bg-white/[0.03] px-6 py-16 text-center">
    <div class="mx-auto grid size-12 place-items-center rounded-2xl bg-lime-300/10 text-2xl text-lime-300">↗</div>
    <h2 class="mt-5 text-xl font-semibold">No links yet</h2>
    <p class="mx-auto mt-2 max-w-md text-slate-400">Create your first short link to start organizing destinations and measuring visits.</p>
  </div>
</section>
