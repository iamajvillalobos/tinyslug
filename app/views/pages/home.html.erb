<% content_for :title, "tinyslug · links that respect people" %>

<section class="relative isolate overflow-hidden">
  <div class="absolute inset-x-0 top-0 -z-10 h-96 bg-[radial-gradient(circle_at_top_left,rgba(190,242,100,0.16),transparent_42%),radial-gradient(circle_at_top_right,rgba(56,189,248,0.12),transparent_38%)]"></div>
  <div class="mx-auto grid max-w-6xl gap-14 px-5 pb-12 pt-20 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:pt-28">
    <div>
      <p class="mb-5 inline-flex rounded-full border border-lime-300/30 bg-lime-300/10 px-3 py-1 text-sm font-medium text-lime-200">Privacy is the default, not an upgrade</p>
      <h1 class="max-w-4xl text-5xl font-black tracking-[-0.04em] text-white sm:text-7xl">Small links.<br><span class="text-lime-300">Clear signals.</span></h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300">Create memorable short links, organize them with tags, and understand genuine visits without storing raw IP addresses.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <%= link_to "Create your account", "/register", class: "rounded-xl bg-lime-300 px-5 py-3 font-semibold text-slate-950 shadow-lg shadow-lime-300/10 transition hover:bg-lime-200" %>
        <%= link_to "View the source", "https://github.com", class: "rounded-xl border border-white/15 bg-white/5 px-5 py-3 font-semibold text-white transition hover:bg-white/10" %>
      </div>
    </div>

    <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-5 shadow-2xl shadow-black/30 backdrop-blur">
      <div class="mb-5 flex items-center justify-between text-sm text-slate-400">
        <span>Last 30 days</span><span class="rounded-full bg-sky-400/10 px-2.5 py-1 text-sky-200">privacy-safe</span>
      </div>
      <p class="text-5xl font-bold tracking-tight">2,418</p>
      <p class="mt-1 text-sm text-slate-400">visits across 14 links</p>
      <div class="mt-8 flex h-28 items-end gap-2" aria-label="Example visit activity chart">
        <% %w[h-[30%] h-[48%] h-[42%] h-[64%] h-[58%] h-[82%] h-[72%] h-[96%] h-[76%] h-[88%] h-[68%] h-full].each do |height_class| %>
          <span class="flex-1 rounded-t bg-gradient-to-t from-sky-500/50 to-lime-300 <%= height_class %>"></span>
        <% end %>
      </div>
      <div class="mt-6 grid grid-cols-2 gap-3 text-sm">
        <div class="rounded-2xl bg-black/20 p-4"><p class="text-slate-400">Top referrer</p><p class="mt-1 font-semibold">Direct / None</p></div>
        <div class="rounded-2xl bg-black/20 p-4"><p class="text-slate-400">Top device</p><p class="mt-1 font-semibold">Mobile</p></div>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto grid max-w-6xl gap-5 px-5 py-16 md:grid-cols-3" aria-labelledby="features-heading">
  <h2 id="features-heading" class="sr-only">Features</h2>
  <% [
    ["01", "Own every address", "Use the primary domain or bring verified custom domains with safe fallbacks."],
    ["02", "Measure less, learn more", "Daily rotating visitor digests make useful analytics possible without durable identity."],
    ["03", "Built to move", "Export CSV, use the documented API, or self-host the whole Rails application."]
  ].each do |number, title, description| %>
    <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
      <p class="font-mono text-sm text-lime-300"><%= number %></p>
      <h3 class="mt-8 text-xl font-semibold"><%= title %></h3>
      <p class="mt-3 leading-7 text-slate-400"><%= description %></p>
    </article>
  <% end %>
</section>
