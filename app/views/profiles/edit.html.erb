<% content_for :title, "Profile settings · tinyslug" %>

<section class="mx-auto max-w-4xl px-5 py-12">
  <div>
    <p class="eyebrow">Settings</p>
    <h1 class="mt-2 font-mono text-3xl font-semibold tracking-tight">Profile</h1>
    <p class="mt-3 text-ink-muted">Update your display name and analytics timezone.</p>
  </div>

  <%= form_with model: @profile, class: "card mt-10 space-y-8 p-6 sm:p-8" do |form| %>
    <% if @profile.errors.any? %>
      <div class="rounded-md border border-danger/40 bg-danger-tint p-4 text-sm text-danger" role="alert">
        <p class="font-semibold">Fix these fields to save your profile:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5"><% @profile.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <div class="grid gap-5 sm:grid-cols-2">
      <div><%= form.label :first_name, class: "label" %><%= form.text_field :first_name, autocomplete: "given-name", class: "input" %></div>
      <div><%= form.label :last_name, class: "label" %><%= form.text_field :last_name, autocomplete: "family-name", class: "input" %></div>
    </div>

    <div><%= form.label :timezone, class: "label" %><%= form.time_zone_select :timezone, ActiveSupport::TimeZone.all, {}, class: "input" %></div>

    <%= form.submit "Save profile", class: "btn btn-primary disabled:cursor-wait disabled:opacity-60", data: { turbo_submits_with: "Saving…" } %>
  <% end %>

  <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <%= link_to "Account and password settings", edit_user_registration_path, class: "link" %>
    <%= link_to "API tokens", api_tokens_path, class: "link" %>
    <%= link_to "Back to dashboard", dashboard_path, class: "link" %>
  </div>
</section>
