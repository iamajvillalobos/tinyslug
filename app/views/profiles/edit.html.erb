<% content_for :title, "Profile settings · tinyslug" %>

<section class="mx-auto max-w-4xl px-5 py-12">
  <div>
    <p class="text-sm font-medium text-lime-300">Settings</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Profile</h1>
    <p class="mt-3 text-slate-400">Update your display name and analytics timezone.</p>
  </div>

  <%= form_with model: @profile, class: "mt-10 space-y-8 rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-8" do |form| %>
    <% if @profile.errors.any? %>
      <div class="rounded-xl border border-rose-300/30 bg-rose-300/10 p-4 text-sm text-rose-100" role="alert">
        <p class="font-semibold">Please review these fields:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5"><% @profile.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <div class="grid gap-5 sm:grid-cols-2">
      <div><%= form.label :first_name, class: "text-sm font-medium" %><%= form.text_field :first_name, autocomplete: "given-name", class: "mt-2 w-full rounded-xl border border-white/15 bg-slate-900 px-4 py-3 outline-none transition focus:border-lime-300 focus:ring-2 focus:ring-lime-300/20" %></div>
      <div><%= form.label :last_name, class: "text-sm font-medium" %><%= form.text_field :last_name, autocomplete: "family-name", class: "mt-2 w-full rounded-xl border border-white/15 bg-slate-900 px-4 py-3 outline-none transition focus:border-lime-300 focus:ring-2 focus:ring-lime-300/20" %></div>
    </div>

    <div><%= form.label :timezone, class: "text-sm font-medium" %><%= form.time_zone_select :timezone, ActiveSupport::TimeZone.all, {}, class: "mt-2 w-full rounded-xl border border-white/15 bg-slate-900 px-4 py-3 outline-none transition focus:border-lime-300 focus:ring-2 focus:ring-lime-300/20" %></div>

    <%= form.submit "Save profile", class: "rounded-xl bg-lime-300 px-5 py-3 font-semibold text-slate-950 transition hover:bg-lime-200 disabled:cursor-wait disabled:opacity-60", data: { turbo_submits_with: "Saving…" } %>
  <% end %>

  <div class="mt-8 grid gap-5 sm:grid-cols-3">
    <%= link_to "Account and password settings", edit_user_registration_path, class: "rounded-2xl border border-white/10 bg-white/[0.03] p-5 font-medium transition hover:bg-white/[0.06]" %>
    <%= link_to "Back to dashboard", dashboard_path, class: "rounded-2xl border border-white/10 bg-white/[0.03] p-5 font-medium transition hover:bg-white/[0.06]" %>
    <%= link_to "API tokens", api_tokens_path, class: "rounded-2xl border border-white/10 bg-white/[0.03] p-5 font-medium transition hover:bg-white/[0.06]" %>
  </div>
</section>
