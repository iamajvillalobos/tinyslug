<% content_for :title, "API tokens · tinyslug" %>
<section class="mx-auto max-w-4xl px-5 py-12">
  <p class="text-sm font-medium text-lime-300">Settings</p><h1 class="mt-2 text-4xl font-bold tracking-tight">API tokens</h1><p class="mt-3 text-slate-400">Create bearer tokens for your own account. The full secret is shown once.</p>

  <% if @plain_text_token %>
    <div class="mt-8 rounded-2xl border border-amber-300/30 bg-amber-300/[0.08] p-5" data-controller="copy" data-copy-text-value="<%= @plain_text_token %>" role="status">
      <p class="font-semibold text-amber-100">Copy this token now. It will not be shown again.</p>
      <p class="mt-3 break-all rounded-xl bg-black/30 p-4 font-mono text-sm"><%= @plain_text_token %></p>
      <button type="button" data-copy-target="button" data-action="copy#copy" class="mt-3 rounded-lg border border-white/15 px-3 py-2 text-sm hover:bg-white/10">Copy token</button>
    </div>
  <% end %>

  <%= form_with model: @api_token, class: "mt-8 flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-5 sm:flex-row sm:items-end" do |form| %>
    <div class="flex-1"><%= form.label :name, class: "text-sm font-medium" %><%= form.text_field :name, required: true, maxlength: 80, placeholder: "CI deploy", class: "mt-2 w-full rounded-xl border border-white/15 bg-slate-900 px-4 py-3 outline-none focus:border-lime-300" %><% if @api_token.errors[:name].any? %><p class="mt-2 text-sm text-rose-200"><%= @api_token.errors[:name].to_sentence %></p><% end %></div>
    <%= form.submit "Create token", class: "rounded-xl bg-lime-300 px-5 py-3 font-semibold text-slate-950 hover:bg-lime-200", data: { turbo_submits_with: "Creating…" } %>
  <% end %>

  <div class="mt-8 space-y-3">
    <% @api_tokens.each do |api_token| %>
      <article class="flex flex-col gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5 sm:flex-row sm:items-center sm:justify-between">
        <div><h2 class="font-semibold"><%= api_token.name %></h2><p class="mt-1 font-mono text-sm text-slate-400"><%= api_token.token_prefix %>…</p><p class="mt-1 text-xs text-slate-500"><%= api_token.revoked? ? "Revoked" : (api_token.last_used_at ? "Last used #{time_ago_in_words(api_token.last_used_at)} ago" : "Never used") %></p></div>
        <% unless api_token.revoked? %><%= button_to "Revoke", revoke_api_token_path(api_token), method: :delete, data: { turbo_confirm: "Revoke this API token?" }, class: "rounded-lg border border-rose-300/20 px-3 py-2 text-sm text-rose-200 hover:bg-rose-300/10" %><% end %>
      </article>
    <% end %>
  </div>
</section>
