<% content_for :title, "API tokens · tinyslug" %>
<section class="mx-auto max-w-4xl px-5 py-12">
  <p class="eyebrow">Settings</p><h1 class="mt-2 font-mono text-3xl font-semibold tracking-tight">API tokens</h1><p class="mt-3 text-ink-muted">Create bearer tokens for your own account. The full secret is shown once.</p>

  <% if @plain_text_token %>
    <div class="mt-8 rounded-md border border-caution/40 bg-caution-tint p-5" data-controller="copy" data-copy-text-value="<%= @plain_text_token %>" role="status">
      <p class="text-sm font-semibold text-caution">Copy this token now. It will not be shown again.</p>
      <p class="mt-3 break-all rounded-md border border-line bg-surface p-4 font-mono text-sm text-ink"><%= @plain_text_token %></p>
      <button type="button" data-copy-target="button" data-action="copy#copy" class="btn btn-secondary mt-3">Copy token</button>
    </div>
  <% end %>

  <%= form_with model: @api_token, class: "card mt-8 flex flex-col gap-3 p-5 sm:flex-row sm:items-end" do |form| %>
    <div class="flex-1"><%= form.label :name, class: "label" %><%= form.text_field :name, required: true, maxlength: 80, placeholder: "CI deploy", class: "input" %><% if @api_token.errors[:name].any? %><p class="mt-2 text-sm text-danger"><%= @api_token.errors[:name].to_sentence %></p><% end %></div>
    <%= form.submit "Create token", class: "btn btn-primary", data: { turbo_submits_with: "Creating…" } %>
  <% end %>

  <div class="mt-8 space-y-3">
    <% @api_tokens.each do |api_token| %>
      <article class="card flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">
        <div><h2 class="text-sm font-medium text-ink"><%= api_token.name %></h2><p class="mt-1 font-mono text-sm text-ink-muted"><%= api_token.token_prefix %>…</p><p class="hint mt-1"><%= api_token.revoked? ? "Revoked" : (api_token.last_used_at ? "Last used #{time_ago_in_words(api_token.last_used_at)} ago" : "Never used") %></p></div>
        <% unless api_token.revoked? %><%= button_to "Revoke", revoke_api_token_path(api_token), method: :delete, data: { turbo_confirm: "Revoke this API token?" }, class: "btn btn-danger px-2.5 py-1 text-xs" %><% end %>
      </article>
    <% end %>
  </div>
</section>
