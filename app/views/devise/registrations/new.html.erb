<% content_for :title, "Create account · tinyslug" %>

<section class="mx-auto max-w-md px-5 py-16">
  <div class="card p-6 sm:p-8">
    <p class="eyebrow">Start shortening</p>
    <h1 class="mt-2 font-mono text-2xl font-semibold tracking-tight text-ink">Create your account</h1>
    <p class="mt-3 text-sm leading-6 text-ink-muted">A confirmation link will be sent to your email.</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-6 space-y-5" }) do |form| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div><%= form.label :username, class: "label" %><%= form.text_field :username, autofocus: true, autocomplete: "username", required: true, class: "input" %></div>
      <div><%= form.label :email, class: "label" %><%= form.email_field :email, autocomplete: "email", required: true, class: "input" %></div>
      <div><%= form.label :password, class: "label" %><%= form.password_field :password, autocomplete: "new-password", required: true, class: "input" %><% if @minimum_password_length %><p class="hint mt-1.5"><%= @minimum_password_length %> characters minimum.</p><% end %></div>
      <div><%= form.label :password_confirmation, class: "label" %><%= form.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "input" %></div>
      <%= form.submit "Create account", class: "btn btn-primary w-full", data: { turbo_submits_with: "Creating…" } %>
    <% end %>

    <p class="mt-6 text-center text-sm text-ink-muted">Already registered? <%= link_to "Log in", new_session_path(resource_name), class: "link" %></p>
  </div>

  <p class="mt-4 text-center text-xs text-ink-muted">tinyslug is free and open source under the MIT license. <%= link_to "Source on GitHub", "https://github.com/iamajvillalobos/tinyslug", class: "link" %></p>
</section>
