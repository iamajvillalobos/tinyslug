<% content_for :title, "Create account · tinyslug" %>

<section class="mx-auto max-w-md px-5 py-16">
  <p class="text-sm font-medium text-lime-300">Start shortening</p>
  <h1 class="mt-2 text-4xl font-bold tracking-tight">Create your account</h1>
  <p class="mt-3 text-slate-400">A confirmation link will be sent to your email.</p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-8 space-y-5" }) do |form| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div><%= form.label :username, class: "text-sm font-medium" %><%= form.text_field :username, autofocus: true, autocomplete: "username", required: true, class: "mt-2 w-full rounded-xl border border-white/15 bg-slate-900 px-4 py-3 outline-none focus:border-lime-300 focus:ring-2 focus:ring-lime-300/20" %></div>
    <div><%= form.label :email, class: "text-sm font-medium" %><%= form.email_field :email, autocomplete: "email", required: true, class: "mt-2 w-full rounded-xl border border-white/15 bg-slate-900 px-4 py-3 outline-none focus:border-lime-300 focus:ring-2 focus:ring-lime-300/20" %></div>
    <div><%= form.label :password, class: "text-sm font-medium" %><% if @minimum_password_length %><span class="ml-1 text-xs text-slate-500">(<%= @minimum_password_length %> characters minimum)</span><% end %><%= form.password_field :password, autocomplete: "new-password", required: true, class: "mt-2 w-full rounded-xl border border-white/15 bg-slate-900 px-4 py-3 outline-none focus:border-lime-300 focus:ring-2 focus:ring-lime-300/20" %></div>
    <div><%= form.label :password_confirmation, class: "text-sm font-medium" %><%= form.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "mt-2 w-full rounded-xl border border-white/15 bg-slate-900 px-4 py-3 outline-none focus:border-lime-300 focus:ring-2 focus:ring-lime-300/20" %></div>
    <%= form.submit "Create account", class: "w-full rounded-xl bg-lime-300 px-5 py-3 font-semibold text-slate-950 hover:bg-lime-200 disabled:opacity-60", data: { turbo_submits_with: "Creating…" } %>
  <% end %>
  <p class="mt-6 text-center text-sm text-slate-400">Already registered? <%= link_to "Log in", new_session_path(resource_name), class: "font-medium text-lime-300 hover:text-lime-200" %></p>
</section>
