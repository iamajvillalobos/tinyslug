<% content_for :title, "Log in · tinyslug" %>

<section class="mx-auto max-w-md px-5 py-16">
  <div class="card p-6 sm:p-8">
    <p class="eyebrow">Welcome back</p>
    <h1 class="mt-2 font-mono text-2xl font-semibold tracking-tight text-ink">Log in</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-5" }) do |form| %>
      <div><%= form.label :email, class: "label" %><%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input" %></div>
      <div><%= form.label :password, class: "label" %><%= form.password_field :password, autocomplete: "current-password", required: true, class: "input" %></div>
      <% if devise_mapping.rememberable? %><label class="flex items-center gap-2 text-sm text-ink"><%= form.check_box :remember_me, class: "size-4 accent-hyperlink" %> Remember me</label><% end %>
      <%= form.submit "Log in", class: "btn btn-primary w-full", data: { turbo_submits_with: "Logging in…" } %>
    <% end %>

    <div class="mt-6 flex flex-wrap justify-between gap-x-4 gap-y-2 text-sm"><%= link_to "Forgot password?", new_password_path(resource_name), class: "link" %><%= link_to "Resend confirmation", new_confirmation_path(resource_name), class: "link" %></div>
  </div>
</section>
