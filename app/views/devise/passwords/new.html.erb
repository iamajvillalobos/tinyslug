<% content_for :title, "Reset password · tinyslug" %>
<section class="mx-auto max-w-md px-5 py-16">
  <p class="text-sm font-medium text-lime-300">Account recovery</p>
  <h1 class="mt-2 text-4xl font-bold tracking-tight">Reset your password</h1>
  <p class="mt-3 text-slate-400">We will email a single-use reset link if the address exists.</p>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 space-y-5" }) do |form| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div><%= form.label :email, class: "text-sm font-medium" %><%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "mt-2 w-full rounded-xl border border-white/15 bg-slate-900 px-4 py-3 outline-none focus:border-lime-300 focus:ring-2 focus:ring-lime-300/20" %></div>
    <%= form.submit "Send reset link", class: "w-full rounded-xl bg-lime-300 px-5 py-3 font-semibold text-slate-950 hover:bg-lime-200", data: { turbo_submits_with: "Sending…" } %>
  <% end %>
  <p class="mt-6 text-center text-sm"><%= link_to "Back to login", new_session_path(resource_name), class: "text-slate-400 hover:text-white" %></p>
</section>
