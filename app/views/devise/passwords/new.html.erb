<% content_for :title, "Reset password · tinyslug" %>

<section class="mx-auto max-w-md px-5 py-16">
  <div class="card p-6 sm:p-8">
    <p class="eyebrow">Account recovery</p>
    <h1 class="mt-2 font-mono text-2xl font-semibold tracking-tight text-ink">Reset your password</h1>
    <p class="mt-3 text-sm leading-6 text-ink-muted">We will email a single-use reset link if the address exists.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-6 space-y-5" }) do |form| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div><%= form.label :email, class: "label" %><%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input" %></div>
      <%= form.submit "Send reset link", class: "btn btn-primary w-full", data: { turbo_submits_with: "Sending…" } %>
    <% end %>

    <p class="mt-6 text-center text-sm"><%= link_to "Back to login", new_session_path(resource_name), class: "link" %></p>
  </div>
</section>
