<% content_for :title, "Unlock account · tinyslug" %>

<section class="mx-auto max-w-md px-5 py-16">
  <div class="card p-6 sm:p-8">
    <p class="eyebrow">Account recovery</p>
    <h1 class="mt-2 font-mono text-2xl font-semibold tracking-tight text-ink">Resend unlock instructions</h1>

    <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "mt-6 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div><%= f.label :email, class: "label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %></div>
      <%= f.submit "Resend unlock instructions", class: "btn btn-primary w-full" %>
    <% end %>

    <div class="mt-6 space-y-2 text-sm"><%= render "devise/shared/links" %></div>
  </div>
</section>
