<% content_for :title, "#{@link.name} · tinyslug" %>
<section class="mx-auto max-w-4xl px-5 py-12">
  <%= link_to "← All links", links_path, class: "link text-sm" %>
  <div class="card mt-6 p-6 sm:p-8">
    <p class="eyebrow"><%= @link.tracking_enabled? ? "Privacy-safe tracking enabled" : "Tracking disabled" %></p>
    <h1 class="mt-2 font-mono text-3xl font-semibold tracking-tight"><%= @link.name %></h1>
    <p class="mt-4 break-all font-mono text-sm text-ink-muted"><%= @link.destination_url %></p>
    <div class="mt-8 rounded-md border border-line bg-paper p-5" data-controller="copy" data-copy-text-value="<%= @link.short_url %>"><p class="break-all font-mono text-lg font-medium text-hyperlink"><%= @link.short_url %></p><button type="button" data-copy-target="button" data-action="copy#copy" class="btn btn-secondary mt-3">Copy short URL</button></div>
    <div class="mt-8 flex flex-wrap gap-3 text-sm"><%= link_to "Edit", edit_link_path(@link), class: "btn btn-primary" %><%= link_to "Analytics", link_analytics_path(@link), class: "btn btn-secondary" %><%= link_to "Download QR (SVG)", qr_link_path(@link, format: :svg), class: "btn btn-secondary" %><%= link_to "Download QR (PNG)", qr_link_path(@link, format: :png), class: "btn btn-secondary" %><%= link_to "Export CSV", export_link_path(@link), class: "btn btn-secondary" %></div>
  </div>
</section>
