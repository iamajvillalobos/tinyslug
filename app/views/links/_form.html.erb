<%= form_with model: link, class: "space-y-5" do |form| %>
  <%= render "links/errors", link: %>

  <div>
    <%= form.label :destination_url, "Destination URL", class: "label" %>
    <%= form.url_field :destination_url, required: true, placeholder: "https://example.com/article", class: "input" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div><%= form.label :name, class: "label" %><%= form.text_field :name, maxlength: 255, placeholder: "Optional label", class: "input" %></div>
    <div><%= form.label :slug, class: "label" %><%= form.text_field :slug, maxlength: 64, placeholder: "Generated when blank", pattern: "[a-z0-9]+(?:-[a-z0-9]+)*", class: "input font-mono" %></div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :tags, class: "label" %>
      <%= form.text_field :tags, value: link.tags.map(&:name).join(", "), placeholder: "docs, launch", class: "input" %>
      <p class="hint mt-2">Separate tags with commas.</p>
    </div>
    <% if @custom_domains.any? %>
      <div><%= form.label :custom_domain_id, "Domain", class: "label" %><%= form.collection_select :custom_domain_id, @custom_domains, :id, :hostname, { include_blank: "Primary domain" }, class: "input" %></div>
    <% end %>
  </div>

  <label class="flex items-start gap-3 rounded-md border border-line bg-paper p-4">
    <%= form.check_box :tracking_enabled, class: "mt-1 size-4 rounded border-line text-hyperlink focus:ring-hyperlink" %>
    <span><span class="block text-sm font-medium text-ink">Privacy-safe analytics</span><span class="mt-1 block text-sm text-ink-muted">Respect DNT/GPC and store no raw IP address or user agent.</span></span>
  </label>

  <%= form.submit link.persisted? ? "Save link" : "Create short link", class: "btn btn-primary disabled:cursor-wait disabled:opacity-60", data: { turbo_submits_with: link.persisted? ? "Saving…" : "Creating…" } %>
<% end %>
