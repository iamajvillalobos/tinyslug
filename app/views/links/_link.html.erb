<article id="<%= dom_id(link) %>" class="card p-5">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to link.short_url, link.short_url, target: "_blank", rel: "noopener", class: "slug-chip text-base break-all" %>
        <span data-controller="copy" data-copy-text-value="<%= link.short_url %>"><button type="button" data-copy-target="button" data-action="copy#copy" class="btn btn-secondary px-2.5 py-1 text-xs">Copy</button></span>
      </div>
      <p class="mt-2 truncate font-mono text-sm text-ink-muted"><%= link.destination_url %></p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <h2 class="max-w-full truncate text-sm font-medium text-ink"><%= link.name %></h2>
        <% if link.tracking_enabled? %><span class="badge bg-hyperlink-tint text-hyperlink">Tracking</span><% end %>
        <% link.tags.each do |tag| %><span class="badge border border-line bg-paper text-ink-muted"><%= tag.name %></span><% end %>
      </div>
    </div>
    <div class="flex shrink-0 flex-wrap items-center gap-4 text-sm">
      <%= link_to "Details", link, data: { turbo_frame: "_top" }, class: "link" %>
      <%= link_to "Edit", edit_link_path(link), data: { turbo_frame: "_top" }, class: "link" %>
      <%= button_to "Delete", link, method: :delete, data: { turbo_confirm: "Delete this short link?" }, class: "btn btn-danger px-2.5 py-1 text-xs" %>
    </div>
  </div>
</article>
