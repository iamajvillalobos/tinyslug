<article id="<%= dom_id(link) %>" class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="truncate text-lg font-semibold"><%= link.name %></h2>
        <% if link.tracking_enabled? %><span class="rounded-full bg-sky-400/10 px-2 py-0.5 text-xs text-sky-200">tracking</span><% end %>
      </div>
      <p class="mt-1 truncate text-sm text-slate-400"><%= link.destination_url %></p>
      <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
        <%= link_to link.short_url, link.short_url, target: "_blank", rel: "noopener", class: "font-mono text-lime-300 hover:text-lime-200" %>
        <span data-controller="copy" data-copy-text-value="<%= link.short_url %>"><button type="button" data-copy-target="button" data-action="copy#copy" class="rounded-lg border border-white/10 px-2 py-1 text-xs text-slate-300 hover:bg-white/10">Copy</button></span>
      </div>
      <% if link.tags.any? %><div class="mt-3 flex flex-wrap gap-2"><% link.tags.each do |tag| %><span class="rounded-full bg-white/[0.06] px-2.5 py-1 text-xs text-slate-300"><%= tag.name %></span><% end %></div><% end %>
    </div>
    <div class="flex shrink-0 flex-wrap gap-2 text-sm">
      <%= link_to "Details", link, class: "rounded-lg border border-white/10 px-3 py-2 hover:bg-white/10" %>
      <%= link_to "Edit", edit_link_path(link), class: "rounded-lg border border-white/10 px-3 py-2 hover:bg-white/10" %>
      <%= button_to "Delete", link, method: :delete, data: { turbo_confirm: "Delete this short link?" }, class: "rounded-lg border border-rose-300/20 px-3 py-2 text-rose-200 hover:bg-rose-300/10" %>
    </div>
  </div>
</article>
