<% content_for :title, "#{@custom_domain.hostname} · tinyslug" %>
<section class="mx-auto max-w-4xl px-5 py-12">
  <%= link_to "← Custom domains", custom_domains_path, class: "link text-sm" %>
  <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <span class="badge <%= { "verified" => "bg-success-tint text-success", "pending" => "bg-caution-tint text-caution" }.fetch(@custom_domain.status, "bg-danger-tint text-danger") %>"><%= @custom_domain.status.humanize %></span>
      <h1 class="mt-2 break-all font-mono text-3xl font-semibold tracking-tight"><%= @custom_domain.hostname %></h1>
      <p class="mt-3 text-ink-muted">TLS and routing to this Rails service are managed by your reverse proxy or hosting platform.</p>
    </div>
    <%= button_to "Check again", verify_custom_domain_path(@custom_domain), method: :post, class: "btn btn-primary", data: { turbo_submits_with: "Checking…" } %>
  </div>
  <div class="mt-10 space-y-5">
    <article class="card p-6"><p class="eyebrow">1. Ownership TXT record</p><dl class="mt-4 space-y-3 text-sm"><div><dt class="hint">Name</dt><dd class="mt-1 break-all rounded-md border border-line bg-paper px-3 py-2 font-mono"><%= @custom_domain.txt_record_name %></dd></div><div><dt class="hint">Value</dt><dd class="mt-1 break-all rounded-md border border-line bg-paper px-3 py-2 font-mono"><%= @custom_domain.verification_token %></dd></div></dl></article>
    <article class="card p-6"><p class="eyebrow">2. Routing record</p><dl class="mt-4 space-y-3 text-sm"><div><dt class="hint">Type</dt><dd class="mt-1 rounded-md border border-line bg-paper px-3 py-2 font-mono">CNAME</dd></div><div><dt class="hint">Name</dt><dd class="mt-1 break-all rounded-md border border-line bg-paper px-3 py-2 font-mono"><%= @custom_domain.hostname %></dd></div><div><dt class="hint">Target</dt><dd class="mt-1 break-all rounded-md border border-line bg-paper px-3 py-2 font-mono"><%= @custom_domain.dns_target.presence || "Not configured by this deployment" %></dd></div></dl></article>
  </div>
  <div class="mt-8 flex flex-wrap gap-3"><%= link_to "Edit fallback", edit_custom_domain_path(@custom_domain), class: "btn btn-secondary" %><%= button_to "Remove domain", @custom_domain, method: :delete, data: { turbo_confirm: "Remove this domain? Its links will move to the primary domain." }, class: "btn btn-danger" %></div>
</section>
