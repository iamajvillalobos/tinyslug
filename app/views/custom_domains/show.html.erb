<% content_for :title, "#{@custom_domain.hostname} · tinyslug" %>
<section class="mx-auto max-w-4xl px-5 py-12">
  <%= link_to "← Custom domains", custom_domains_path, class: "text-sm text-slate-400 hover:text-white" %><div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-sm font-medium text-lime-300"><%= @custom_domain.status.humanize %></p><h1 class="mt-2 font-mono text-3xl font-bold tracking-tight"><%= @custom_domain.hostname %></h1><p class="mt-3 text-slate-400">TLS and routing to this Rails service are managed by your reverse proxy or hosting platform.</p></div><%= button_to "Check again", verify_custom_domain_path(@custom_domain), method: :post, class: "rounded-xl bg-lime-300 px-4 py-2.5 font-semibold text-slate-950 hover:bg-lime-200", data: { turbo_submits_with: "Checking…" } %></div>
  <div class="mt-10 space-y-5">
    <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-6"><p class="text-sm font-medium text-slate-400">1. Ownership TXT record</p><dl class="mt-4 space-y-3 text-sm"><div><dt class="text-slate-500">Name</dt><dd class="mt-1 break-all font-mono"><%= @custom_domain.txt_record_name %></dd></div><div><dt class="text-slate-500">Value</dt><dd class="mt-1 break-all font-mono"><%= @custom_domain.verification_token %></dd></div></dl></article>
    <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-6"><p class="text-sm font-medium text-slate-400">2. Routing record</p><dl class="mt-4 space-y-3 text-sm"><div><dt class="text-slate-500">Type</dt><dd class="mt-1 font-mono">CNAME</dd></div><div><dt class="text-slate-500">Name</dt><dd class="mt-1 break-all font-mono"><%= @custom_domain.hostname %></dd></div><div><dt class="text-slate-500">Target</dt><dd class="mt-1 break-all font-mono"><%= @custom_domain.dns_target.presence || "Not configured by this deployment" %></dd></div></dl></article>
  </div>
  <div class="mt-8 flex flex-wrap gap-3"><%= link_to "Edit fallback", edit_custom_domain_path(@custom_domain), class: "rounded-xl border border-white/15 px-4 py-2.5 text-sm hover:bg-white/10" %><%= button_to "Remove domain", @custom_domain, method: :delete, data: { turbo_confirm: "Remove this domain? Its links will move to the primary domain." }, class: "rounded-xl border border-rose-300/20 px-4 py-2.5 text-sm text-rose-200 hover:bg-rose-300/10" %></div>
</section>
