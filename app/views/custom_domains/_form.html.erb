<%= form_with model: custom_domain, class: "space-y-5" do |form| %>
  <%= render "errors", custom_domain: %>
  <% unless custom_domain.persisted? %><div><%= form.label :hostname, class: "label" %><%= form.text_field :hostname, required: true, placeholder: "go.example.com", class: "input font-mono" %><p class="hint mt-2">ASCII or punycode hostname only. Do not include a scheme, port, or path.</p></div><% end %>
  <div><%= form.label :fallback_url, "Fallback URL", class: "label" %><%= form.url_field :fallback_url, placeholder: "https://example.com", class: "input font-mono" %><p class="hint mt-2">Optional destination when a slug does not exist on this host.</p></div>
  <%= form.submit custom_domain.persisted? ? "Save fallback" : "Add domain", class: "btn btn-primary", data: { turbo_submits_with: "Saving…" } %>
<% end %>
