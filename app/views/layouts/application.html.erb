<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
  <head>
    <title><%= content_for(:title) || "tinyslug · private link management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Privacy-first short links, custom domains, and useful analytics.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tinyslug">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full text-slate-100 antialiased">
    <header class="border-b border-white/10">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5" aria-label="Primary navigation">
        <%= link_to root_path, class: "flex items-center gap-2 text-lg font-semibold tracking-tight" do %>
          <span class="grid size-8 place-items-center rounded-xl bg-lime-300 font-black text-slate-950">t</span>
          tinyslug
        <% end %>
        <div class="flex items-center gap-4 text-sm text-slate-300">
          <% if user_signed_in? %>
            <%= link_to "Dashboard", dashboard_path, class: "transition hover:text-white" %>
            <%= link_to "Links", links_path, class: "transition hover:text-white" %>
            <%= link_to "Analytics", analytics_path, class: "transition hover:text-white" %>
            <%= link_to "Domains", custom_domains_path, class: "hidden transition hover:text-white lg:inline" %>
            <%= link_to "Settings", edit_profile_path, class: "transition hover:text-white" %>
            <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "rounded-lg border border-white/15 px-3 py-2 font-medium text-white transition hover:bg-white/10" %>
          <% else %>
            <%= link_to "Privacy", privacy_path, class: "hidden transition hover:text-white sm:inline" %>
            <%= link_to "Log in", new_user_session_path, class: "transition hover:text-white" %>
            <%= link_to "Create account", new_user_registration_path, class: "rounded-lg bg-lime-300 px-3 py-2 font-semibold text-slate-950 transition hover:bg-lime-200" %>
          <% end %>
        </div>
      </nav>
    </header>

    <div id="flash-messages"><%= render "shared/flash" %></div>

    <main>
      <%= yield %>
    </main>

    <footer class="mx-auto mt-24 flex max-w-6xl flex-col gap-3 border-t border-white/10 px-5 py-8 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <p>Short links without long-lived visitor identities.</p>
      <div class="flex gap-4"><%= link_to "API", api_docs_path, class: "hover:text-white" %><%= link_to "Terms", terms_path, class: "hover:text-white" %><%= link_to "Privacy", privacy_path, class: "hover:text-white" %></div>
    </footer>
  </body>
</html>
