<% content_for :title, "#{@profile.display_name} · tinyslug" %>
<% content_for :description, @profile.bio.presence || "Links shared by #{@profile.display_name}." %>
<% content_for :head do %>
  <meta property="og:title" content="<%= @profile.display_name %>">
  <meta property="og:description" content="<%= @profile.bio.presence || "Links shared by #{@profile.display_name}." %>">
  <meta property="og:type" content="profile">
  <meta property="og:url" content="<%= public_profile_url(@user.username) %>">
  <% if @profile.avatar.attached? %><meta property="og:image" content="<%= url_for(@profile.avatar) %>"><% end %>
<% end %>

<section class="mx-auto max-w-2xl px-5 py-16 text-center">
  <% if @profile.avatar.attached? %>
    <%= image_tag @profile.avatar, alt: "", class: "mx-auto size-28 rounded-full border border-white/15 object-cover" %>
  <% else %>
    <div class="mx-auto grid size-28 place-items-center rounded-full bg-lime-300 text-4xl font-black text-slate-950" aria-hidden="true"><%= @profile.display_name.first.upcase %></div>
  <% end %>

  <h1 class="mt-6 text-4xl font-bold tracking-tight"><%= @profile.display_name %></h1>
  <p class="mt-2 text-sm text-lime-300">@<%= @user.username %></p>
  <% if @profile.bio.present? %><p class="mx-auto mt-5 max-w-xl whitespace-pre-line text-slate-300"><%= @profile.bio %></p><% end %>

  <% if @profile_links.any? %>
    <h2 class="sr-only">Shared links</h2>
    <ul class="mt-10 space-y-3">
      <% @profile_links.each do |profile_link| %>
        <li><%= link_to profile_link.link.name, profile_link.link.short_url, class: "block rounded-2xl border border-white/10 bg-white/[0.05] px-5 py-4 font-semibold transition hover:border-lime-300/50 hover:bg-white/[0.09] focus:outline-none focus:ring-2 focus:ring-lime-300" %></li>
      <% end %>
    </ul>
  <% end %>

  <% if @social_links.any? %>
    <h2 class="mt-10 text-sm font-semibold uppercase tracking-widest text-slate-500">Elsewhere</h2>
    <ul class="mt-4 flex flex-wrap justify-center gap-3">
      <% @social_links.each do |social_link| %>
        <li><%= link_to social_link.label, social_link.url, rel: "me noopener", class: "inline-block rounded-xl border border-white/15 px-4 py-2 text-sm font-medium transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-lime-300" %></li>
      <% end %>
    </ul>
  <% end %>
</section>
