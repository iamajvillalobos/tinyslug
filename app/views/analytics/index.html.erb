<% content_for :title, "Analytics · tinyslug" %>
<section class="mx-auto max-w-6xl px-5 py-12" data-controller="analytics">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div><p class="eyebrow">Privacy-safe signals</p><h1 class="mt-2 font-mono text-3xl font-semibold tracking-tight"><%= @link ? @link.name : "Analytics" %></h1><p class="mt-3 text-ink-muted">Aggregate activity in <%= current_user.profile.timezone %>, with no raw visitor identities.</p></div>
    <nav class="flex gap-2" aria-label="Analytics period">
      <%= link_to "7 days", analytics_path(period: 7), class: "btn btn-secondary #{'border-hyperlink/30 bg-hyperlink-tint text-hyperlink' if @analytics.period_days == 7}" %>
      <%= link_to "30 days", analytics_path(period: 30), class: "btn btn-secondary #{'border-hyperlink/30 bg-hyperlink-tint text-hyperlink' if @analytics.period_days == 30}" %>
    </nav>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    <article class="card p-6"><p class="eyebrow">Total visits</p><p class="mt-2 font-mono text-3xl font-semibold text-ink"><%= number_with_delimiter(@analytics.total_visits) %></p></article>
    <article class="card p-6"><p class="eyebrow">Unique daily visitors</p><p class="mt-2 font-mono text-3xl font-semibold text-ink"><%= number_with_delimiter(@analytics.unique_visits) %></p></article>
  </div>

  <article class="card mt-6 p-6">
    <h2 class="font-mono text-lg font-semibold">Visits over time</h2>
    <div class="mt-6"><%= line_chart @analytics.visits_over_time, colors: ["#2323E8"], library: { plugins: { legend: { display: false } }, scales: { x: { grid: { color: "#E3E7ED" }, ticks: { color: "#5B6472" } }, y: { grid: { color: "#E3E7ED" }, ticks: { color: "#5B6472" } } } } %></div>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-left text-sm"><caption class="sr-only">Daily visit totals</caption><thead><tr><th class="eyebrow py-2">Date</th><th class="eyebrow py-2 text-right">Visits</th></tr></thead><tbody class="divide-y divide-line"><% @analytics.visits_over_time.each do |date, count| %><tr><td class="py-2 font-mono"><%= date %></td><td class="py-2 text-right font-mono"><%= count %></td></tr><% end %></tbody></table>
    </div>
  </article>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <% { "Top links" => @analytics.top_links.transform_keys { |(_id, name)| name }, "Countries" => @analytics.countries, "Referrers" => @analytics.referrers, "Browsers" => @analytics.browsers, "Devices" => @analytics.devices }.each do |title, rows| %>
      <article class="card p-6"><h2 class="font-mono text-lg font-semibold"><%= title %></h2><div class="mt-4 overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr><th class="eyebrow py-2"><%= title.singularize %></th><th class="eyebrow py-2 text-right">Visits</th></tr></thead><tbody class="divide-y divide-line"><% rows.each do |label, count| %><tr><td class="max-w-64 truncate py-2"><%= label %></td><td class="py-2 text-right font-mono"><%= count %></td></tr><% end %></tbody></table></div></article>
    <% end %>
  </div>
</section>
