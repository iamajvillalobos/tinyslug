<% if notice %>
  <div class="mx-auto mt-5 max-w-6xl px-5" role="status">
    <p class="rounded-md border border-hyperlink/20 bg-hyperlink-tint px-4 py-3 text-sm text-hyperlink"><%= notice %></p>
  </div>
<% end %>
<% if alert %>
  <div class="mx-auto mt-5 max-w-6xl px-5" role="alert">
    <p class="rounded-md border border-danger/20 bg-danger-tint px-4 py-3 text-sm text-danger"><%= alert %></p>
  </div>
<% end %>
