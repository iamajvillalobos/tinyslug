<% if notice %>
  <div class="mx-auto mt-5 max-w-6xl px-5" role="status">
    <p class="rounded-xl border border-lime-300/30 bg-lime-300/10 px-4 py-3 text-sm text-lime-100"><%= notice %></p>
  </div>
<% end %>
<% if alert %>
  <div class="mx-auto mt-5 max-w-6xl px-5" role="alert">
    <p class="rounded-xl border border-rose-300/30 bg-rose-300/10 px-4 py-3 text-sm text-rose-100"><%= alert %></p>
  </div>
<% end %>
