<% content_for :title, "Public shortener · tinyslug" %>
<section class="mx-auto max-w-xl px-5 py-16">
  <p class="text-sm font-medium text-lime-300">Anonymous shortener</p><h1 class="mt-2 text-4xl font-bold tracking-tight">Make a private short link</h1><p class="mt-3 text-slate-400">Public links are automatically generated, uneditable, and never tracked.</p>
  <%= form_with model: @link, url: public_shortener_path, class: "mt-8 space-y-5" do |form| %><%= render "links/errors", link: @link %><div><%= form.label :destination_url, "Destination URL", class: "text-sm font-medium" %><%= form.url_field :destination_url, required: true, autofocus: true, placeholder: "https://example.com", class: "mt-2 w-full rounded-xl border border-white/15 bg-slate-900 px-4 py-3 outline-none focus:border-lime-300 focus:ring-2 focus:ring-lime-300/20" %></div><%= form.submit "Shorten", class: "w-full rounded-xl bg-lime-300 px-5 py-3 font-semibold text-slate-950 hover:bg-lime-200", data: { turbo_submits_with: "Shortening…" } %><% end %>
  <% if @link.persisted? %><div class="mt-8 rounded-2xl border border-lime-300/20 bg-lime-300/[0.06] p-5" data-controller="copy" data-copy-text-value="<%= @link.short_url %>"><p class="text-sm text-lime-100">Your short link</p><p class="mt-2 break-all font-mono text-lg"><%= @link.short_url %></p><button type="button" data-copy-target="button" data-action="copy#copy" class="mt-3 rounded-lg border border-white/15 px-3 py-2 text-sm">Copy</button></div><% end %>
</section>
