<% content_for :title, "Public shortener · tinyslug" %>

<section class="mx-auto max-w-xl px-5 py-16">
  <p class="eyebrow">Anonymous shortener</p>
  <h1 class="mt-3 font-mono text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Make a private short link</h1>
  <p class="mt-3 text-sm leading-6 text-ink-muted">Public links are automatically generated, uneditable, and never tracked.</p>

  <%= form_with model: @link, url: public_shortener_path, class: "card mt-8 space-y-5 p-6" do |form| %>
    <%= render "links/errors", link: @link %>
    <div><%= form.label :destination_url, "Destination URL", class: "label" %><%= form.url_field :destination_url, required: true, autofocus: true, placeholder: "https://example.com", class: "input" %></div>
    <%= form.submit "Shorten", class: "btn btn-primary w-full", data: { turbo_submits_with: "Shortening…" } %>
  <% end %>

  <% if @link.persisted? %>
    <div class="card mt-6 p-6" data-controller="copy" data-copy-text-value="<%= @link.short_url %>">
      <p class="eyebrow">Your short link</p>
      <p class="mt-3 break-all"><span class="slug-chip text-base"><%= @link.short_url %></span></p>
      <button type="button" data-copy-target="button" data-action="copy#copy" class="btn btn-secondary mt-4">Copy</button>
    </div>
  <% end %>
</section>
