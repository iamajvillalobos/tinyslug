# Application URLs
APP_HOST=localhost:3000
APP_PROTOCOL=http

# PostgreSQL. Omit this when using a native local server and socket auth.
# DATABASE_URL=postgres://tinyslug:tinyslug@localhost:5432/tinyslug_development

# Optional features
PUBLIC_SHORTENER_ENABLED=false
REDIRECT_VISIT_RETENTION_DAYS=90

# Required in production. Generate independent values with `openssl rand -hex 32`.
VISITOR_DIGEST_SECRET=
API_TOKEN_DIGEST_SECRET=
RATE_LIMIT_DIGEST_SECRET=

# Custom domains
CUSTOM_DOMAIN_DNS_TARGET=
CUSTOM_DOMAIN_TXT_PREFIX=_tinyslug-verification

# Optional email delivery
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=

# Optional S3-compatible Active Storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=

# Optional local GeoIP database
GEOIP_DATABASE_PATH=
